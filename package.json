{
  "name": "chatatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.7.0 <27", "npm": ">=11.19.0 <12" },
  "allowScripts": { "better-sqlite3": false },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "test": "npm run build && playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
